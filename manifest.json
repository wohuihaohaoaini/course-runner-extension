{
  "manifest_version": 3,
  "name": "课程流程助手",
  "version": "1.0.1",
  "minimum_chrome_version": "111",
  "description": "悬浮窗课程流程助手：按任务点播放与换节，可开关的章节测验及视频弹题 AI 识别。",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "permissions": [
    "storage",
    "tabs",
    "webNavigation",
    "notifications",
    "activeTab",
    "scripting"
  ],
  "host_permissions": [
    "https://*.chaoxing.com/*",
    "https://api.deepseek.com/*"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.chaoxing.com/*"
      ],
      "js": [
        "content/common.js",
        "content/detect.js",
        "content/jobs.js",
        "content/tabs.js",
        "content/video-question.js",
        "content/mute.js",
        "content/blank-editor.js",
        "content/quiz.js",
        "content/video-ai.js",
        "content/ai-flow.js",
        "content/video-trial.js",
        "content/commands.js",
        "content/runner.js",
        "content/layout.js",
        "content/panel.js",
        "content/main.js"
      ],
      "run_at": "document_idle",
      "all_frames": true
    }
  ],
  "commands": {
    "toggle-mute": {
      "suggested_key": {
        "default": "Alt+M"
      },
      "description": "一键静音 / 取消静音课程视频"
    }
  }
}
